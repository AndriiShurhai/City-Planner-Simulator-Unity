%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
# Enhanced and Commented Unity Scene File
# Original objects and their settings are preserved.
# Comments added for clarity, understanding, and potential areas of improvement.

# --- Occlusion Culling Settings ---
# Defines settings for Unity's occlusion culling system, which disables rendering
# of objects obscured by other objects from the camera's viewpoint.
--- !u!29 &1
OcclusionCullingSettings:
  m_ObjectHideFlags: 0 # Standard Unity internal flag.
  serializedVersion: 2 # Version of the OcclusionCullingSettings format.
  m_OcclusionBakeSettings:
    smallestOccluder: 5 # The minimum size (in units) an object must be to be considered an occluder during baking.
    smallestHole: 0.25 # The smallest radius (in units) of a hole/gap the occlusion culling system will try to see through.
    backfaceThreshold: 100 # A value from 0-100. Higher values mean backfaces are more likely to be culled. 100 means backfaces are aggressively tested.
  m_SceneGUID: 00000000000000000000000000000000 # GUID of the scene, usually 0 unless explicitly set or managed by version control.
  m_OcclusionCullingData: {fileID: 0} # Reference to the baked OcclusionCullingData asset. {fileID: 0} means no data is currently baked or assigned.
                                      # Suggestion: Bake Occlusion Culling (Window > Rendering > Occlusion Culling) if you have complex scenes.

# --- Render Settings ---
# Defines global rendering settings for the scene, such as fog, ambient light, skybox, etc.
--- !u!104 &2
RenderSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 10 # Version of the RenderSettings format.
  m_Fog: 0 # Fog enabled (1) or disabled (0). Currently: Disabled.
  m_FogColor: {r: 0.5, g: 0.5, b: 0.5, a: 1} # Color of the fog if enabled.
  m_FogMode: 3 # Fog mode: 1 (Linear), 2 (Exponential), 3 (ExponentialSquared). Currently: ExponentialSquared.
  m_FogDensity: 0.01 # Density of the fog for exponential modes.
  m_LinearFogStart: 0 # Start distance for linear fog.
  m_LinearFogEnd: 300 # End distance for linear fog.
  m_AmbientSkyColor: {r: 0.212, g: 0.227, b: 0.259, a: 1} # Ambient light color from the sky.
  m_AmbientEquatorColor: {r: 0.114, g: 0.125, b: 0.133, a: 1} # Ambient light color from the equator (for Gradient ambient mode).
  m_AmbientGroundColor: {r: 0.047, g: 0.043, b: 0.035, a: 1} # Ambient light color from the ground (for Gradient ambient mode).
  m_AmbientIntensity: 1 # Intensity of the ambient light.
  m_AmbientMode: 3 # Ambient lighting mode: 0 (Skybox), 1 (Gradient), 3 (Color). Currently: Skybox (but color values suggest Gradient or Color might have been intended or previously used). If Skybox, m_SkyboxMaterial is used.
  m_SubtractiveShadowColor: {r: 0.42, g: 0.478, b: 0.627, a: 1} # Color of shadows in Subtractive lighting mode.
  m_SkyboxMaterial: {fileID: 0} # Reference to the Skybox material. {fileID: 0} means no skybox assigned.
                                # Suggestion: Assign a Skybox material if using Skybox ambient mode or clear flags.
  m_HaloStrength: 0.5 # Strength of light halos.
  m_FlareStrength: 1 # Strength of lens flares.
  m_FlareFadeSpeed: 3 # Speed at which lens flares fade.
  m_HaloTexture: {fileID: 0} # Texture used for light halos. {fileID: 0} means no halo texture assigned.
  m_SpotCookie: {fileID: 10001, guid: 0000000000000000e000000000000000, type: 0} # Default cookie texture for SpotLights (usually a soft circle).
  m_DefaultReflectionMode: 0 # How default reflections are generated: 0 (Skybox), 1 (Custom). Currently: Skybox.
  m_DefaultReflectionResolution: 128 # Resolution of the default reflection cubemap.
  m_ReflectionBounces: 1 # Number of bounces for reflections.
  m_ReflectionIntensity: 1 # Intensity of reflections.
  m_CustomReflection: {fileID: 0} # Reference to a custom reflection cubemap. {fileID: 0} means no custom reflection assigned.
  m_Sun: {fileID: 0} # Reference to the primary Directional Light acting as the sun. {fileID: 0} means no sun source linked.
                    # Suggestion: Assign your main directional light here for skybox procedural effects and certain lighting features.
  m_UseRadianceAmbientProbe: 0 # Whether to use Radiance Ambient Probes (part of advanced GI). Currently: Disabled.

# --- Lightmap Settings ---
# Configures settings related to global illumination (GI), light baking, and lightmaps.
--- !u!157 &3
LightmapSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 13 # Version of the LightmapSettings format.
  m_BakeOnSceneLoad: 0 # Whether to bake lightmaps when the scene is loaded in the editor. Currently: Disabled.
  m_GISettings: # Global Illumination Settings
    serializedVersion: 2
    m_BounceScale: 1 # Multiplier for indirect light bounce intensity.
    m_IndirectOutputScale: 1 # Scale for the intensity of indirect light stored in lightmaps/probes.
    m_AlbedoBoost: 1 # Boosts the albedo contribution to GI calculations.
    m_EnvironmentLightingMode: 0 # How environment lighting contributes to GI. 0 = Realtime, 1 = Baked.
    m_EnableBakedLightmaps: 0 # Enable baked lightmaps. Currently: Disabled.
    m_EnableRealtimeLightmaps: 0 # Enable realtime lightmaps (deprecated in favor of Enlighten Realtime GI or Progressive Lightmapper). Currently: Disabled.
                                # Suggestion: If using static geometry and lights, consider enabling Baked Lightmaps for better performance and visuals.
  m_LightmapEditorSettings: # Settings specific to the lightmap baking process.
    serializedVersion: 12
    m_Resolution: 2 # Resolution of lightmaps in texels per unit.
    m_BakeResolution: 40 # Resolution used for baking individual lightmap charts.
    m_AtlasSize: 1024 # Maximum size of the lightmap atlas (texture).
    m_AO: 0 # Ambient Occlusion enabled (1) or disabled (0) for baked lightmaps. Currently: Disabled.
    m_AOMaxDistance: 1 # Maximum distance for AO rays.
    m_CompAOExponent: 1 # Exponent for AO compression.
    m_CompAOExponentDirect: 0 # Exponent for direct AO compression.
    m_ExtractAmbientOcclusion: 0 # Whether to extract AO into a separate texture mask.
    m_Padding: 2 # Padding (in texels) between charts in the lightmap atlas.
    m_LightmapParameters: {fileID: 0} # Reference to a LightmapParameters asset for fine-grained control. {fileID: 0} uses default parameters.
    m_LightmapsBakeMode: 1 # Lightmap baking mode: 0 (Non-Directional), 1 (Directional). Currently: Directional.
    m_TextureCompression: 1 # Enable texture compression for lightmaps. Currently: Enabled.
    m_ReflectionCompression: 2 # Compression quality for reflection probes.
    m_MixedBakeMode: 2 # Mode for mixed lighting: 1 (Subtractive), 2 (Shadowmask). Currently: Shadowmask.
    m_BakeBackend: 1 # Lightmap baking backend: 0 (Enlighten - deprecated), 1 (Progressive CPU/GPU). Currently: Progressive.
    m_PVRSampling: 1 # Progressive Lightmapper (PVR) sampling mode.
    m_PVRDirectSampleCount: 32 # Number of samples for direct lighting in PVR.
    m_PVRSampleCount: 512 # Number of samples for indirect lighting in PVR.
    m_PVRBounces: 2 # Number of light bounces in PVR.
    m_PVREnvironmentSampleCount: 256 # Number of environment samples in PVR.
    m_PVREnvironmentReferencePointCount: 2048 # Reference points for environment PVR.
    m_PVRFilteringMode: 1 # PVR filtering mode.
    m_PVRDenoiserTypeDirect: 1 # Denoiser type for direct PVR lighting.
    m_PVRDenoiserTypeIndirect: 1 # Denoiser type for indirect PVR lighting.
    m_PVRDenoiserTypeAO: 1 # Denoiser type for PVR AO.
    m_PVRFilterTypeDirect: 0 # Filter type for direct PVR.
    m_PVRFilterTypeIndirect: 0 # Filter type for indirect PVR.
    m_PVRFilterTypeAO: 0 # Filter type for PVR AO.
    m_PVREnvironmentMIS: 1 # Multiple Importance Sampling for PVR environment.
    m_PVRCulling: 1 # Culling for PVR.
    m_PVRFilteringGaussRadiusDirect: 1 # Gauss filter radius for direct PVR.
    m_PVRFilteringGaussRadiusIndirect: 1 # Gauss filter radius for indirect PVR.
    m_PVRFilteringGaussRadiusAO: 1 # Gauss filter radius for PVR AO.
    m_PVRFilteringAtrousPositionSigmaDirect: 0.5 # Atrous filter sigma for direct PVR.
    m_PVRFilteringAtrousPositionSigmaIndirect: 2 # Atrous filter sigma for indirect PVR.
    m_PVRFilteringAtrousPositionSigmaAO: 1 # Atrous filter sigma for PVR AO.
    m_ExportTrainingData: 0 # Export training data for machine learning denoiser.
    m_TrainingDataDestination: TrainingData # Destination folder for training data.
    m_LightProbeSampleCountMultiplier: 4 # Multiplier for light probe sample counts.
  m_LightingDataAsset: {fileID: 20201, guid: 0000000000000000f000000000000000, type: 0} # Reference to the LightingDataAsset (stores baked data). GUID of all zeros means it's likely a placeholder or no data.
  m_LightingSettings: {fileID: 0} # Reference to a LightingSettings asset (not commonly used directly, settings are usually part of LightmapSettings).

# --- NavMesh Settings ---
# Configures settings for Unity's NavMesh navigation system, used for AI pathfinding.
--- !u!196 &4
NavMeshSettings:
  serializedVersion: 2
  m_ObjectHideFlags: 0
  m_BuildSettings: # Settings for baking the NavMesh.
    serializedVersion: 3
    agentTypeID: 0 # ID of the agent type these settings apply to (0 is usually default 'Humanoid').
    agentRadius: 0.5 # Radius of the navigation agent.
    agentHeight: 2 # Height of the navigation agent.
    agentSlope: 45 # Maximum slope (in degrees) the agent can walk on.
    agentClimb: 0.4 # Maximum height the agent can step up.
    ledgeDropHeight: 0 # How far an agent can drop down. (0 implies cannot drop, requires explicit off-mesh links).
    maxJumpAcrossDistance: 0 # How far an agent can jump. (0 implies cannot jump).
    minRegionArea: 2 # Minimum area of a NavMesh region to not be discarded.
    manualCellSize: 0 # Use manual cell size (1) or automatic (0). Currently: Automatic.
    cellSize: 0.16666667 # Size of NavMesh voxels if manualCellSize is 1.
    manualTileSize: 0 # Use manual tile size (1) or automatic (0). Currently: Automatic.
    tileSize: 256 # Size of NavMesh tiles if manualTileSize is 1.
    buildHeightMesh: 0 # Whether to build a detailed height mesh (can be performance intensive).
    maxJobWorkers: 0 # Max number of threads for baking (0 for default).
    preserveTilesOutsideBounds: 0 # Whether to keep NavMesh tiles outside defined bounds.
    debug: # Debug visualization settings for NavMesh.
      m_Flags: 0 # Debug flags (e.g., draw polys, boundaries). 0 means no debug drawing.
  m_NavMeshData: {fileID: 0} # Reference to the baked NavMeshData asset. {fileID: 0} means no data is currently baked or assigned.
                            # Suggestion: Bake NavMesh (Window > AI > Navigation) if AI agents need to navigate the scene.

# --- GameObject: Canvas ---
# The root GameObject for the UI. Contains Canvas, CanvasScaler, and GraphicRaycaster components.
--- !u!1 &76080504
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component: # List of components attached to this GameObject.
  - component: {fileID: 76080505} # RectTransform
  - component: {fileID: 76080508} # Canvas
  - component: {fileID: 76080507} # CanvasScaler (MonoBehaviour)
  - component: {fileID: 76080506} # GraphicRaycaster (MonoBehaviour)
  m_Layer: 5 # UI Layer.
  m_Name: Canvas # Name of the GameObject.
  m_TagString: Untagged # Tag of the GameObject.
  m_Icon: {fileID: 0} # Custom icon for the GameObject in the hierarchy.
  m_NavMeshLayer: 0 # Navigation layer for this object.
  m_StaticEditorFlags: 0 # Flags for static batching, lightmap static, etc. 0 means not static.
  m_IsActive: 1 # GameObject is active (1) or inactive (0).

# --- RectTransform (for Canvas) ---
# Defines the position, rotation, scale, and anchoring for the Canvas GameObject.
--- !u!224 &76080505 # This is the RectTransform component for the Canvas GameObject (ID: 76080504)
RectTransform:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 76080504} # Link back to the GameObject this component is on.
  m_LocalRotation: {x: 0, y: 0, z: 0, w: 1} # Local rotation (Quaternion).
  m_LocalPosition: {x: 0, y: 0, z: 0} # Local position.
  m_LocalScale: {x: 0, y: 0, z: 0} # Local scale. Note: Scale 0,0,0 makes it invisible. This might be overridden by Canvas or an error.
                                    # For a Screen Space Overlay canvas, its RectTransform's scale is often driven by the Canvas itself.
                                    # If RenderMode is ScreenSpace-Camera or WorldSpace, this scale matters more.
  m_ConstrainProportionsScale: 0 # Whether to constrain proportions when scaling in the editor.
  m_Children: # List of child RectTransforms.
  - {fileID: 1049060289} # Child: Panel (ID: 1049060288's RectTransform)
  - {fileID: 410939538}  # Child: Image (ID: 410939537's RectTransform)
  - {fileID: 2111944776} # Child: Panel (ID: 2111944775's RectTransform, for Text)
  m_Father: {fileID: 0} # Parent RectTransform. {fileID: 0} means it's a root UI element or its parent is a regular Transform.
  m_LocalEulerAnglesHint: {x: 0, y: 0, z: 0} # Editor hint for Euler angles.
  m_AnchorMin: {x: 0, y: 0} # Minimum anchor point (normalized 0-1) relative to parent.
  m_AnchorMax: {x: 0, y: 0} # Maximum anchor point (normalized 0-1) relative to parent.
  m_AnchoredPosition: {x: 0, y: 0} # Position of the pivot relative to anchors.
  m_SizeDelta: {x: 0, y: 0} # Size of the RectTransform relative to the space defined by anchors.
                            # For a ScreenSpace - Overlay canvas, these values often represent the screen size or reference resolution.
  m_Pivot: {x: 0, y: 0} # Pivot point (normalized 0-1) of the RectTransform itself. (0,0) is bottom-left.

# --- GraphicRaycaster (MonoBehaviour, on Canvas) ---
# Allows the Canvas to intercept input events (clicks, touches) for UI elements.
# Script GUID: dc42784cf147c0c48a680349fa168899 (UnityEditor.UI.GraphicRaycaster)
--- !u!114 &76080506 # This is a MonoBehaviour: GraphicRaycaster
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 76080504} # Attached to Canvas.
  m_Enabled: 1 # Component is enabled.
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc42784cf147c0c48a680349fa168899, type: 3} # Script reference (GraphicRaycaster).
  m_Name: # Optional name for the component instance.
  m_EditorClassIdentifier: # Editor class identifier.
  m_IgnoreReversedGraphics: 1 # Whether to ignore graphics facing away from the raycaster.
  m_BlockingObjects: 0 # Types of 3D objects that can block UI raycasts: 0 (None), 1 (TwoD), 2 (ThreeD), 3 (All). Currently: None.
  m_BlockingMask: # LayerMask for 3D objects that can block UI raycasts.
    serializedVersion: 2
    m_Bits: 4294967295 # All layers selected.

# --- CanvasScaler (MonoBehaviour, on Canvas) ---
# Controls the overall scale and pixel density of UI elements within the Canvas.
# Script GUID: 0cd44c1031e13a943bb63640046fad76 (UnityEngine.UI.CanvasScaler)
--- !u!114 &76080507 # This is a MonoBehaviour: CanvasScaler
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 76080504} # Attached to Canvas.
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0cd44c1031e13a943bb63640046fad76, type: 3} # Script reference (CanvasScaler).
  m_Name:
  m_EditorClassIdentifier:
  m_UiScaleMode: 0 # UI Scale Mode: 0 (Constant Pixel Size), 1 (Scale With Screen Size), 2 (Constant Physical Size). Currently: Constant Pixel Size.
                   # Suggestion: Consider 'Scale With Screen Size' for responsive UI across different resolutions.
  m_ReferencePixelsPerUnit: 100 # Pixels per unit for sprites used in the UI.
  m_ScaleFactor: 1 # Scale factor if m_UiScaleMode is Constant Pixel Size.
  m_ReferenceResolution: {x: 800, y: 600} # Reference resolution if m_UiScaleMode is Scale With Screen Size.
  m_ScreenMatchMode: 0 # How to match screen resolution: 0 (Match Width Or Height), 1 (Expand), 2 (Shrink).
  m_MatchWidthOrHeight: 0 # If ScreenMatchMode is MatchWidthOrHeight: 0 (Width), 0.5 (Halfway), 1 (Height).
  m_PhysicalUnit: 3 # Physical unit for Constant Physical Size: 0 (Centimeters), 1 (Millimeters), 2 (Inches), 3 (Points), 4 (Picas).
  m_FallbackScreenDPI: 96 # Fallback DPI if device DPI is unavailable.
  m_DefaultSpriteDPI: 96 # Default DPI for sprites.
  m_DynamicPixelsPerUnit: 1 # Used by TextMeshPro for dynamic font sizing.
  m_PresetInfoIsWorld: 0 # Internal flag for editor presets.

# --- Canvas (Component, on Canvas GameObject) ---
# The main component that defines a UI drawing area.
--- !u!223 &76080508 # This is the Canvas component itself, attached to GameObject 76080504
Canvas:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 76080504} # Attached to Canvas.
  m_Enabled: 1
  serializedVersion: 3
  m_RenderMode: 0 # Render Mode: 0 (Screen Space - Overlay), 1 (Screen Space - Camera), 2 (World Space). Currently: Screen Space - Overlay.
  m_Camera: {fileID: 0} # Target camera if RenderMode is Screen Space - Camera or World Space. {fileID: 0} for Overlay.
  m_PlaneDistance: 100 # Distance from camera if RenderMode is Screen Space - Camera.
  m_PixelPerfect: 0 # Enable pixel perfect rendering. Can have performance implications. Currently: Disabled.
  m_ReceivesEvents: 1 # Whether this canvas receives input events.
  m_OverrideSorting: 0 # Whether to override the sorting layer and order.
  m_OverridePixelPerfect: 0 # Whether to override pixel perfect setting on child canvases.
  m_SortingBucketNormalizedSize: 0 # Internal sorting value.
  m_VertexColorAlwaysGammaSpace: 0 # If vertex colors are in gamma space. Usually 0 for linear color space workflow.
  m_AdditionalShaderChannelsFlag: 25 # Bitmask for additional shader channels (e.g., TexCoord1, Normal, Tangent). 25 = TexCoord1 + Tangent.
  m_UpdateRectTransformForStandalone: 0 # Internal editor flag.
  m_SortingLayerID: 0 # ID of the sorting layer. 0 is usually 'Default'.
  m_SortingOrder: 107 # Order within the sorting layer. Higher numbers render on top. This is a relatively high value.
  m_TargetDisplay: 0 # Which display to render to (for multi-display setups). 0 is primary.

# --- GameObject: Image ---
# A UI Image element, likely a background or decorative image.
# Child of the main Canvas.
--- !u!1 &410939537
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 410939538} # RectTransform
  - component: {fileID: 410939540} # CanvasRenderer
  - component: {fileID: 410939539} # Image (MonoBehaviour)
  m_Layer: 5 # UI Layer.
  m_Name: Image
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1

# --- RectTransform (for Image) ---
# Anchored to stretch across its parent (Canvas), but with a negative X SizeDelta, making it narrower.
--- !u!224 &410939538 # RectTransform for Image GameObject (ID: 410939537)
RectTransform:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 410939537} # Attached to Image.
  m_LocalRotation: {x: 0, y: 0, z: 0, w: 1}
  m_LocalPosition: {x: 0, y: 0, z: 0} # Positioned at (0,0,0) relative to its anchors within the parent.
  m_LocalScale: {x: 1, y: 1, z: 1}
  m_ConstrainProportionsScale: 0
  m_Children: [] # No children.
  m_Father: {fileID: 76080505} # Parent is the Canvas's RectTransform.
  m_LocalEulerAnglesHint: {x: 0, y: 0, z: 0}
  m_AnchorMin: {x: 0, y: 0} # Anchored to bottom-left of parent.
  m_AnchorMax: {x: 1, y: 1} # Anchored to top-right of parent (stretches).
  m_AnchoredPosition: {x: 0, y: 0} # Pivot is at the center of the anchored area.
  m_SizeDelta: {x: -772.5363, y: 0} # Width is ParentWidth - 772.5363. Height is ParentHeight + 0.
                                    # This creates an image that is narrower than the parent, centered horizontally.
  m_Pivot: {x: 0.5, y: 0.5} # Pivot is at the center of this RectTransform.

# --- Image (MonoBehaviour, on Image GameObject) ---
# The actual Image component that displays a sprite.
# Script GUID: fe87c0e1cc204ed48ad3b37840f39efc (UnityEngine.UI.Image)
--- !u!114 &410939539 # MonoBehaviour: Image component
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 410939537} # Attached to Image.
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe87c0e1cc204ed48ad3b37840f39efc, type: 3} # Script reference (Image).
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0} # Custom material for the image. {fileID: 0} uses default UI material.
  m_Color: {r: 1, g: 1, b: 1, a: 1} # Tint color (White, opaque).
  m_RaycastTarget: 1 # Whether this image blocks raycasts (e.g., for clicks). Currently: Yes.
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0} # Padding for raycast interaction.
  m_Maskable: 1 # Whether this image can be masked by a UI Mask component.
  m_OnCullStateChanged: # UnityEvent triggered when culling state changes.
    m_PersistentCalls:
      m_Calls: [] # No persistent listeners.
  m_Sprite: {fileID: -675791031188208443, guid: 1d8c50fae0b828d4fa928e2aa6a5d8b3, type: 3} # Source Sprite asset.
  m_Type: 0 # Image type: 0 (Simple), 1 (Sliced), 2 (Tiled), 3 (Filled). Currently: Simple.
  m_PreserveAspect: 0 # Whether to maintain the sprite's aspect ratio. Currently: No.
  m_FillCenter: 1 # For Sliced/Tiled images, whether to fill the center.
  m_FillMethod: 4 # For Filled images, method of filling: 0 (Horizontal), 1 (Vertical), 2 (Radial90), 3 (Radial180), 4 (Radial360). Currently: Radial360.
  m_FillAmount: 1 # For Filled images, how much of the image is filled (0-1).
  m_FillClockwise: 1 # For Filled images, direction of fill.
  m_FillOrigin: 0 # For Filled images, origin point of the fill.
  m_UseSpriteMesh: 0 # Whether to use the sprite's tight mesh for rendering (good for non-rectangular sprites).
  m_PixelsPerUnitMultiplier: 1 # Multiplier for the sprite's pixels per unit.

# --- CanvasRenderer (on Image GameObject) ---
# Component required for UI elements to be drawn on a Canvas.
--- !u!222 &410939540 # CanvasRenderer for Image GameObject
CanvasRenderer:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 410939537} # Attached to Image.
  m_CullTransparentMesh: 1 # Optimization: cull mesh if it's completely transparent.

# --- GameObject: DialogueManager ---
# (Typo: "DialogeManager", corrected to "DialogueManager" in comments for clarity)
# A non-UI GameObject likely containing a custom script to manage dialogue.
--- !u!1 &602671406
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 602671408} # Transform
  - component: {fileID: 602671407} # DialogueManager (Custom MonoBehaviour)
  m_Layer: 0 # Default Layer.
  m_Name: DialogeManager # Original name with typo. Suggest renaming to "DialogueManager" in Unity Editor.
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1

# --- DialogueManager (Custom MonoBehaviour, on DialogueManager GameObject) ---
# Custom script for handling dialogue logic.
# Script GUID: a9e903c75add19748b4db76c24558021 (This is your custom script)
--- !u!114 &602671407 # MonoBehaviour: Custom DialogueManager script
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 602671406} # Attached to DialogueManager.
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9e903c75add19748b4db76c24558021, type: 3} # Reference to your custom script.
  m_Name:
  m_EditorClassIdentifier:
  dialogueText: {fileID: 1799510610} # Reference to the TextMeshProUGUI component that will display dialogue. (Points to Text (TMP)'s TextMeshProUGUI component)
  dialogueLines: # Array of dialogue strings.
  - Residents can't stand the medical care in the city...
  sceneName: MedicalAttackScene # Name of the scene to load, likely after dialogue.
  typingSpeed: 0.05 # Speed for the typing effect.

# --- Transform (for DialogueManager GameObject) ---
# Position, rotation, and scale of the DialogueManager GameObject in the scene.
# Its position (795, 520, -6) seems specific; may or may not be relevant for a manager object.
--- !u!4 &602671408 # Transform for DialogueManager GameObject
Transform:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
