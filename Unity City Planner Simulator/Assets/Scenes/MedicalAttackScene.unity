  m_AnchoredPosition: {x: 0, y: -434.97156} # Pivot is shifted down by 435 units from parent center.
  m_SizeDelta: {x: 0, y: -869.9431} # Width = ParentWidth + 0. Height = ParentHeight - 869.9.
                                     # This creates a full-width panel, but shorter in height, positioned lower on the screen.
  m_Pivot: {x: 0.5, y: 0.5}

