  m_FontData:
    m_Font: {fileID: 12800000, guid: 4beb055f07aaff244873dec698d0363e, type: 3}
    m_FontSize: 14
    m_FontStyle: 3
    m_BestFit: 1
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 1
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "City rates are key indicators that define the overall condition, events,
    and income of your metropolis. Keeping these rates within healthy ranges not
    only boosts your economy but also helps prevent negative events such as robberies
    or health crises.\n\nHappiness Rate\n\nIt measures Citizens\u2019 general well-being,
    balanced across safety, employment, health, education, and fun.\nAffects tax
    income (happier citizens spend more) and unlocks special bonuses.\n\nHow calculated:\n\nWeighted
    average of\n\nSafety\u2003\u2003\u2003(Weight: 3)\n\nEmployment\u2003(Weight:
    2)\n\nHealth\u2003\u2003\u2003(Weight: 2)\n\nEducation\u2003(Weight: 1)\n\nAmusement
    bonus (10 \xD7 Number of amusement buildings)."
