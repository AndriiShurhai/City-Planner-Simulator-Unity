  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 2100000, guid: 3a839a51a817efa4a83a2c6ad3e6e691, type: 2}
  m_Color: {r: 0, g: 0, b: 0, a: 1}
