  m_FontData:
    m_Font: {fileID: 12800000, guid: 4beb055f07aaff244873dec698d0363e, type: 3}
    m_FontSize: 14
    m_FontStyle: 3
    m_BestFit: 1
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "City rates are key indicators that define the overall condition, events,
    and income of your metropolis. Keeping these rates within healthy ranges not
    only boosts your economy but also helps prevent negative events such as robberies
    or health crises.\n\nEducation Rate\n\nIt measures quality and reach of schools
    and universities. Higher education reduces crime and increases health; skilled
    workforce boosts productivity.\n\nHow calulated:\n\nBase Education: 20\n\nIncreases
    by (Sum of Education Contributions from all schools)\n\nSmoothed with \u03B1
    = 0.05 over time, clamped 0\u2013100."
